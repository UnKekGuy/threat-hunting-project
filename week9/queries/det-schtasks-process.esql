// Gap from week 8: T1053.005 seen from the process-creation side (Sysmon 1).
// schtasks.exe /Create whose /TR action is PowerShell or an encoded command.
// Works even when task auditing (4698) is off, which is common.
FROM winlogs
| WHERE EventID == 1
  AND ENDS_WITH(TO_LOWER(Image), "\\schtasks.exe")
  AND TO_LOWER(CommandLine) LIKE "*/create*"
  AND (TO_LOWER(CommandLine) LIKE "*powershell*"
    OR TO_LOWER(CommandLine) LIKE "*-enc*"
    OR TO_LOWER(CommandLine) LIKE "*iex*")
| KEEP @timestamp, dataset, User, Image, ParentImage, CommandLine
| SORT @timestamp DESC
