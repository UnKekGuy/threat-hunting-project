// Gap from week 8: T1053.005 Scheduled Task persistence (Security 4698 side).
// A scheduled task is created whose action runs PowerShell / an encoded
// command / IEX - the LockBit "UpdateAdobeTask" pattern. The TaskContent of a
// 4698 carries the full schtasks /Create line, so we match it there.
FROM winlogs
| WHERE EventID == 4698
  AND (TO_LOWER(TaskContent) LIKE "*powershell*"
    OR TO_LOWER(TaskContent) LIKE "*-enc*"
    OR TO_LOWER(TaskContent) LIKE "*iex*"
    OR TO_LOWER(TaskContent) LIKE "*frombase64string*")
| KEEP @timestamp, dataset, HostComputer, SubjectUserName, TaskName
| SORT @timestamp DESC
